{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "streamlit",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": ["-m", "streamlit", "run", "juxtacellular/physmap_app.py"],
      "port": 8501
    },
    {
      "name": "jupyterlab",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": ["-m", "jupyterlab", "--no-browser"],
      "port": 8888,
      "autoPort": true
    }
  ]
}

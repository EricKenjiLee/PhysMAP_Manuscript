cat(modality_name, ": k =", optimal_k, ", MARI =", round(max_mari, 4), "\n")
}
# Save results
save(ARIv_GMM, ARIv_GMM_alone, ARIvmelted_GMM, ARIvmelted_GMM_alone,
file = "GMM_MARI_results.RData")
library(ggplot2)
library(dplyr)
# Function to create pie charts for a given modality
create_celltype_pie_charts <- function(data_object, cluster_column, modality_name) {
# Create dataframe with cell IDs, cell types, and cluster assignments
df <- data.frame(
id = 1:length(data_object@meta.data[[cluster_column]]),
celltype = data_object@meta.data$layerCellType,
cluster_ix = data_object@meta.data[[cluster_column]]
)
# Calculate counts and proportions
class_counts <- df %>%
group_by(cluster_ix, celltype) %>%
summarise(Count = n(), .groups = "drop")
class_counts <- class_counts %>%
group_by(cluster_ix) %>%
mutate(Proportion = Count / sum(Count))
# Create pie chart
p <- ggplot(class_counts, aes(x = "", y = Proportion, fill = celltype)) +
geom_bar(stat = "identity", width = 1) +
coord_polar(theta = "y") +
facet_wrap(~cluster_ix, labeller = label_both) +
labs(title = paste("Cell Type Composition by", modality_name, "Cluster"),
fill = "Cell Type") +
theme_void() +
theme(legend.position = "bottom",
plot.title = element_text(hjust = 0.5))
return(p)
}
# Create pie charts for each modality
# 1. WF modality
cat("Creating pie charts for WF modality...\n")
p_WF_pie <- create_celltype_pie_charts(tempWF$data, "WF_snn_res.2", "WF")
show(p_WF_pie)
# 2. ISI modality
cat("Creating pie charts for ISI modality...\n")
p_ISI_pie <- create_celltype_pie_charts(tempISI$data, "ISI_snn_res.2", "ISI")
show(p_ISI_pie)
# 3. PSTH modality
cat("Creating pie charts for PSTH modality...\n")
p_PSTH_pie <- create_celltype_pie_charts(tempPSTH$data, "PSTH_snn_res.2", "PSTH")
show(p_PSTH_pie)
# 4. Concatenated modality
cat("Creating pie charts for Concatenated modality...\n")
p_concat_pie <- create_celltype_pie_charts(tempConcat$data, "concat_snn_res.2", "Concatenated")
show(p_concat_pie)
# 5. WNN (for comparison)
cat("Creating pie charts for WNN...\n")
p_WNN_pie <- create_celltype_pie_charts(juxtaData, "wsnn_res.2", "WNN")
show(p_WNN_pie)
# Optional: Create a summary comparison showing cluster purity for each modality
calculate_cluster_purity <- function(data_object, cluster_column) {
df <- data.frame(
celltype = data_object@meta.data$layerCellType,
cluster_ix = data_object@meta.data[[cluster_column]]
)
purity_scores <- df %>%
group_by(cluster_ix) %>%
summarise(
total_cells = n(),
max_celltype_count = max(table(celltype)),
purity = max_celltype_count / total_cells,
dominant_celltype = names(table(celltype))[which.max(table(celltype))],
.groups = "drop"
)
return(purity_scores)
}
# Calculate purity for each modality
cat("\n=== Calculating cluster purity for each modality ===\n")
purity_WF <- calculate_cluster_purity(tempWF$data, "WF_snn_res.2") %>%
mutate(modality = "WF")
purity_ISI <- calculate_cluster_purity(tempISI$data, "ISI_snn_res.2") %>%
mutate(modality = "ISI")
purity_PSTH <- calculate_cluster_purity(tempPSTH$data, "PSTH_snn_res.2") %>%
mutate(modality = "PSTH")
purity_concat <- calculate_cluster_purity(tempConcat$data, "concat_snn_res.2") %>%
mutate(modality = "Concatenated")
purity_WNN <- calculate_cluster_purity(juxtaData, "wsnn_res.2") %>%
mutate(modality = "WNN")
# Combine all purity scores
all_purity <- rbind(purity_WF, purity_ISI, purity_PSTH, purity_concat, purity_WNN)
# Plot purity comparison
p_purity_comparison <- ggplot(all_purity, aes(x = modality, y = purity, fill = modality)) +
geom_boxplot(alpha = 0.7) +
geom_jitter(width = 0.2, alpha = 0.6) +
labs(title = "Cluster Purity Comparison Across Modalities",
subtitle = "Purity = fraction of cells in dominant cell type per cluster",
x = "Modality",
y = "Cluster Purity",
fill = "Modality") +
theme_minimal() +
theme(legend.position = "none") +
ylim(0, 1)
show(p_purity_comparison)
# Print summary statistics
cat("\n=== Average cluster purity by modality ===\n")
purity_summary <- all_purity %>%
group_by(modality) %>%
summarise(
mean_purity = mean(purity),
median_purity = median(purity),
min_purity = min(purity),
max_purity = max(purity),
n_clusters = n(),
.groups = "drop"
)
print(purity_summary)
# Create a detailed comparison table
cat("\n=== Number of clusters by modality ===\n")
cluster_counts <- all_purity %>%
group_by(modality) %>%
summarise(n_clusters = n(), .groups = "drop")
print(cluster_counts)

geom_errorbar(aes(ymin=Acc-se, ymax=Acc+se), width=.2,
position=position_dodge(0.3))
p = p + theme(text=element_text(size=20)) + ylim(50,100)
p = p + ggtitle(paste0("Classifier at Embedding-D = ",as.character(UMAP.components)))
show(p)

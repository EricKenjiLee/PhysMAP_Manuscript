# Calculate average modality weights for each cluster (3 modalities: WF, ISI, PSTH)
modality_contrib <- umapEmbeddings %>%
mutate(cluster_ix = juxtaData@meta.data$wsnn_res.2) %>%
group_by(cluster_ix) %>%
summarise(
avg_WF_weight = mean(juxtaData.WF.weight, na.rm = TRUE),
avg_ISI_weight = mean(juxtaData.ISI.weight, na.rm = TRUE),
avg_PSTH_weight = mean(juxtaData.PSTH.weight, na.rm = TRUE),
.groups = "drop"
) %>%
# Normalize to ensure weights sum to 1 (in case of any numerical issues)
mutate(
total_weight = avg_WF_weight + avg_ISI_weight + avg_PSTH_weight,
norm_WF_weight = avg_WF_weight / total_weight,
norm_ISI_weight = avg_ISI_weight / total_weight,
norm_PSTH_weight = avg_PSTH_weight / total_weight
)
# Reshape for plotting (base R approach to avoid needing tidyr)
modality_contrib_long <- data.frame(
cluster_ix = rep(modality_contrib$cluster_ix, 3),
modality = rep(c("WF", "ISI", "PSTH"), each = nrow(modality_contrib)),
proportion = c(modality_contrib$norm_WF_weight,
modality_contrib$norm_ISI_weight,
modality_contrib$norm_PSTH_weight)
)
# Create pie charts for each cluster
p_modality_pie <- ggplot(modality_contrib_long, aes(x = "", y = proportion, fill = modality)) +
geom_bar(stat = "identity", width = 1) +
coord_polar(theta = "y") +
facet_wrap(~cluster_ix, labeller = label_both) +
labs(title = "Average Modality Contribution to Each Cluster",
fill = "Modality") +
scale_fill_manual(values = c("WF" = "#F39922", "ISI" = "#12A84B", "PSTH" = "#0B78BE")) +
theme_void() +
theme(legend.position = "bottom")
show(p_modality_pie)
# Alternative: Stacked bar chart representation
p_modality_bar <- ggplot(modality_contrib_long, aes(x = as.factor(cluster_ix), y = proportion, fill = modality)) +
geom_bar(stat = "identity", position = "stack") +
labs(title = "Modality Contributions by Cluster",
x = "Cluster",
y = "Proportion",
fill = "Modality") +
scale_fill_manual(values = c("WF" = "#F39922", "ISI" = "#12A84B", "PSTH" = "#0B78BE")) +
theme_minimal() +
theme(legend.position = "bottom")
show(p_modality_bar)
# Print the numerical values
print("Average modality weights per cluster:")
print(modality_contrib)
# Additional analysis: Which clusters are more driven by which modality?
modality_dominance <- modality_contrib_viz %>%
mutate(
# Calculate dominance strength (difference between top and second highest)
dominance_strength = pmax(norm_WF_weight, norm_ISI_weight, norm_PSTH_weight) -
apply(cbind(norm_WF_weight, norm_ISI_weight, norm_PSTH_weight), 1,
function(x) sort(x, decreasing = TRUE)[2])
) %>%
arrange(desc(dominance_strength))
print("Cluster modality dominance (sorted by strength):")
print(modality_dominance)
# Create a ternary-like visualization showing the three-way balance
# This creates a scatter plot where each point is a cluster, positioned by its modality weights
library(ggplot2)
# Create a triangular coordinate system approximation and add dominance info
modality_contrib_viz <- modality_contrib %>%
mutate(
# Find the dominant modality for each cluster
dominant_modality = case_when(
norm_WF_weight > norm_ISI_weight & norm_WF_weight > norm_PSTH_weight ~ "WF",
norm_ISI_weight > norm_WF_weight & norm_ISI_weight > norm_PSTH_weight ~ "ISI",
norm_PSTH_weight > norm_WF_weight & norm_PSTH_weight > norm_ISI_weight ~ "PSTH",
TRUE ~ "Tie"  # Handle ties
),
# Convert to approximate ternary coordinates for visualization
x_coord = norm_WF_weight + 0.5 * norm_PSTH_weight,
y_coord = sqrt(3)/2 * norm_PSTH_weight
)
p_ternary_approx <- ggplot(modality_contrib_viz, aes(x = x_coord, y = y_coord)) +
geom_point(aes(size = 3, color = dominant_modality), alpha = 0.7) +
geom_text(aes(label = cluster_ix), vjust = -1.5, size = 3) +
scale_color_manual(values = c("WF" = "#F39922", "ISI" = "#12A84B", "PSTH" = "#0B78BE")) +
labs(title = "Cluster Positions by Modality Balance",
subtitle = "Position reflects relative contribution of each modality",
x = "WF → ISI axis",
y = "PSTH contribution",
color = "Dominant Modality") +
theme_minimal() +
guides(size = FALSE)  # Remove size legend
show(p_ternary_approx)
# Summary statistics
cat("\n=== Modality Contribution Summary ===\n")
cat("Overall average contributions across all clusters:\n")
cat("WF:", mean(modality_contrib$norm_WF_weight), "\n")
cat("ISI:", mean(modality_contrib$norm_ISI_weight), "\n")
cat("PSTH:", mean(modality_contrib$norm_PSTH_weight), "\n")
cat("\nNumber of clusters dominated by each modality:\n")
table(modality_dominance$dominant_modality)
# Function to invert softmax transformation
invert_softmax <- function(weights) {
# Apply log to invert the exp() part of softmax
# Add small epsilon to avoid log(0)
epsilon <- 1e-10
log_weights <- log(weights + epsilon)
return(log_weights)
}
# Calculate average modality weights for each cluster with inverted softmax
modality_contrib_inverted <- umapEmbeddings %>%
mutate(cluster_ix = juxtaData@meta.data$wsnn_res.2) %>%
# First invert the softmax transformation
mutate(
inv_WF_weight = invert_softmax(juxtaData.WF.weight),
inv_ISI_weight = invert_softmax(juxtaData.ISI.weight),
inv_PSTH_weight = invert_softmax(juxtaData.PSTH.weight)
) %>%
group_by(cluster_ix) %>%
summarise(
avg_inv_WF_weight = mean(inv_WF_weight, na.rm = TRUE),
avg_inv_ISI_weight = mean(inv_ISI_weight, na.rm = TRUE),
avg_inv_PSTH_weight = mean(inv_PSTH_weight, na.rm = TRUE),
.groups = "drop"
) %>%
# Now do simple normalization (weight / sum of weights)
mutate(
total_weight = avg_inv_WF_weight + avg_inv_ISI_weight + avg_inv_PSTH_weight,
norm_WF_weight = avg_inv_WF_weight / total_weight,
norm_ISI_weight = avg_inv_ISI_weight / total_weight,
norm_PSTH_weight = avg_inv_PSTH_weight / total_weight
) %>%
# Handle potential negative values by shifting and renormalizing
mutate(
# Shift to make all weights positive
shift_WF = norm_WF_weight - min(c(norm_WF_weight, norm_ISI_weight, norm_PSTH_weight)),
shift_ISI = norm_ISI_weight - min(c(norm_WF_weight, norm_ISI_weight, norm_PSTH_weight)),
shift_PSTH = norm_PSTH_weight - min(c(norm_WF_weight, norm_ISI_weight, norm_PSTH_weight)),
# Renormalize
total_shifted = shift_WF + shift_ISI + shift_PSTH,
final_WF_weight = shift_WF / total_shifted,
final_ISI_weight = shift_ISI / total_shifted,
final_PSTH_weight = shift_PSTH / total_shifted
)
# Alternative approach: Use exponential of negative weights to handle negatives more elegantly
modality_contrib_exp <- umapEmbeddings %>%
mutate(cluster_ix = juxtaData@meta.data$wsnn_res.2) %>%
# First invert the softmax transformation
mutate(
inv_WF_weight = invert_softmax(juxtaData.WF.weight),
inv_ISI_weight = invert_softmax(juxtaData.ISI.weight),
inv_PSTH_weight = invert_softmax(juxtaData.PSTH.weight)
) %>%
group_by(cluster_ix) %>%
summarise(
avg_inv_WF_weight = mean(inv_WF_weight, na.rm = TRUE),
avg_inv_ISI_weight = mean(inv_ISI_weight, na.rm = TRUE),
avg_inv_PSTH_weight = mean(inv_PSTH_weight, na.rm = TRUE),
.groups = "drop"
) %>%
# Convert back to positive domain using exp and then normalize
mutate(
exp_WF_weight = exp(avg_inv_WF_weight),
exp_ISI_weight = exp(avg_inv_ISI_weight),
exp_PSTH_weight = exp(avg_inv_PSTH_weight),
total_exp_weight = exp_WF_weight + exp_ISI_weight + exp_PSTH_weight,
norm_WF_weight = exp_WF_weight / total_exp_weight,
norm_ISI_weight = exp_ISI_weight / total_exp_weight,
norm_PSTH_weight = exp_PSTH_weight / total_exp_weight
)
# Compare both approaches - let's use the exponential approach as it's more mathematically sound
modality_contrib_final <- modality_contrib_exp
# Reshape for plotting (base R approach)
modality_contrib_long_inv <- data.frame(
cluster_ix = rep(modality_contrib_final$cluster_ix, 3),
modality = rep(c("WF", "ISI", "PSTH"), each = nrow(modality_contrib_final)),
proportion = c(modality_contrib_final$norm_WF_weight,
modality_contrib_final$norm_ISI_weight,
modality_contrib_final$norm_PSTH_weight)
)
# Create pie charts for each cluster (inverted softmax approach)
p_modality_pie_inv <- ggplot(modality_contrib_long_inv, aes(x = "", y = proportion, fill = modality)) +
geom_bar(stat = "identity", width = 1) +
coord_polar(theta = "y") +
facet_wrap(~cluster_ix, labeller = label_both) +
labs(title = "Modality Contribution to Each Cluster (Inverted Softmax + Simple Averaging)",
subtitle = "Weights inverted from softmax then normalized by sum",
fill = "Modality") +
scale_fill_manual(values = c("WF" = "#F39922", "ISI" = "#12A84B", "PSTH" = "#0B78BE")) +
theme_void() +
theme(legend.position = "bottom")
show(p_modality_pie_inv)
# Alternative: Stacked bar chart representation
p_modality_bar_inv <- ggplot(modality_contrib_long_inv, aes(x = as.factor(cluster_ix), y = proportion, fill = modality)) +
geom_bar(stat = "identity", position = "stack") +
labs(title = "Modality Contributions by Cluster (Inverted Softmax + Simple Averaging)",
x = "Cluster",
y = "Proportion",
fill = "Modality") +
scale_fill_manual(values = c("WF" = "#F39922", "ISI" = "#12A84B", "PSTH" = "#0B78BE")) +
theme_minimal() +
theme(legend.position = "bottom")
show(p_modality_bar_inv)
# Compare with original softmax approach
print("=== Comparison: Original vs Inverted Softmax ===")
print("Original softmax weights per cluster:")
print(modality_contrib[, c("cluster_ix", "norm_WF_weight", "norm_ISI_weight", "norm_PSTH_weight")])
print("Inverted softmax weights per cluster:")
print(modality_contrib_final[, c("cluster_ix", "norm_WF_weight", "norm_ISI_weight", "norm_PSTH_weight")])
# Calculate correlation between original and inverted approaches
cor_WF <- cor(modality_contrib$norm_WF_weight, modality_contrib_final$norm_WF_weight, use = "complete.obs")
cor_ISI <- cor(modality_contrib$norm_ISI_weight, modality_contrib_final$norm_ISI_weight, use = "complete.obs")
cor_PSTH <- cor(modality_contrib$norm_PSTH_weight, modality_contrib_final$norm_PSTH_weight, use = "complete.obs")
cat("\n=== Correlations between original and inverted softmax approaches ===\n")
cat("WF correlation:", round(cor_WF, 3), "\n")
cat("ISI correlation:", round(cor_ISI, 3), "\n")
cat("PSTH correlation:", round(cor_PSTH, 3), "\n")
# Create side-by-side comparison plot
library(cowplot)
p_comparison <- plot_grid(
p_modality_pie + ggtitle("Original Softmax Weights"),
p_modality_pie_inv + ggtitle("Inverted Softmax + Simple Average"),
nrow = 2,
labels = c("A", "B")
)
show(p_comparison)
# Summary statistics for inverted approach
cat("\n=== Inverted Softmax Modality Contribution Summary ===\n")
cat("Overall average contributions across all clusters:\n")
cat("WF:", mean(modality_contrib_final$norm_WF_weight), "\n")
cat("ISI:", mean(modality_contrib_final$norm_ISI_weight), "\n")
cat("PSTH:", mean(modality_contrib_final$norm_PSTH_weight), "\n")
# Find dominant modalities with inverted approach
modality_dominance_inv <- modality_contrib_final %>%
mutate(
dominant_modality = case_when(
norm_WF_weight > norm_ISI_weight & norm_WF_weight > norm_PSTH_weight ~ "WF",
norm_ISI_weight > norm_WF_weight & norm_ISI_weight > norm_PSTH_weight ~ "ISI",
norm_PSTH_weight > norm_WF_weight & norm_PSTH_weight > norm_ISI_weight ~ "PSTH",
TRUE ~ "Tie"
),
dominance_strength = pmax(norm_WF_weight, norm_ISI_weight, norm_PSTH_weight) -
apply(cbind(norm_WF_weight, norm_ISI_weight, norm_PSTH_weight), 1,
function(x) sort(x, decreasing = TRUE)[2])
) %>%
arrange(desc(dominance_strength))
cat("\nNumber of clusters dominated by each modality (inverted softmax):\n")
table(modality_dominance_inv$dominant_modality)
